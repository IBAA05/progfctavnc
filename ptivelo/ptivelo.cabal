cabal-version:      3.0
name:               ptivelo
version:            0.1.0.0

common deps
    default-language: GHC2024
    ghc-options:      -O2 -Wall
    build-depends:    aeson, base, lucid2, scotty, text,
                      wai-extra, wai-middleware-static

library
    import:             deps
    hs-source-dirs:     src
    exposed-modules:    Model View

executable ptivelo
    import:             deps
    hs-source-dirs:     app
    main-is:            main.hs
    build-depends:      ptivelo
    ghc-options: -threaded

